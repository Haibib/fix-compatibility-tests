3\cc\00 \05\01\be\06\03\b0\7f \05\0a\06\03\cf\00 \05\01\d7\02\01\00\01\01\05\0d\0a\00\05\02\ff\ff\ff\ff\03\d3\00\01\05\19\06\90\05\1c\06.\05(\06X\05\19<\03\ac\7f.\05\0c\06\03\d5\00 \05\01\be\06\03\a7\7f \05\0a\06\03\d8\00 \05\01\d7\02\01\00\01\01\05\0d\0a\00\05\02\ff\ff\ff\ff\03\dc\00\01\05\19\06\90\05\1c\06.\05(\06X\05\19<\03\a3\7f.\05\0c\06\03\de\00 \05\01\be\06\03\9e\7f \05\0a\06\03\e1\00 \05\01\d7\02\01\00\01\01\05\11\0a\00\05\02\ff\ff\ff\ff\03\e5\00\01\05\1d\06\ac\05 \06.\05+\06X\053<\03\9a\7f.\05\11\06\03\e7\00\90\05\1d\06 \05 .\05+X\053\06;\06\03\9a\7f.\05\0c\06\03\e8\00 \05\01\03\0a\ba\06\03\8e\7f \05\11\03\e6\00 \05\1c\06x\05\1f.\05*\06X\05\1c<\03\96\7f.\05\0c\06\03\eb\00 \05\01\dd\06\03\8e\7f \05\10\06\03\ed\00 \05\1c\06t\05\1f\06.\05*\06X\05\1c<\03\93\7f.\05\0c\06\03\ee\00 \05\01\da\06\03\8e\7f \05\0a\06\03\f1\00 \05\01\f3\02\01\00\01\01\05\11\0a\00\05\02\ff\ff\ff\ff\03\f5\00\01\05\1d\06\ac\05 \06.\05+\06X\053<\03\8a\7f.\05\11\06\03\f7\00\90\05\1d\06 \05 .\05+X\053\06;\06\03\8a\7f.\05\0c\06\03\f8\00 \05\01\03\0a\9e\06\03\fe~ \05\11\03\f6\00 \05\1c\06x\05\1f.\05*\06X\05\1c<\03\86\7f.\05\0c\06\03\fb\00 \05\01\c1\06\03\fe~ \05\10\06\03\fd\00 \05\1c\06t\05\1f\06.\05*\06X\05\1c<\03\83\7f.\05\0c\06\03\fe\00 \05\01\be\06\03\fe~ \05\0a\06\03\81\01 \05\01\d7\02\01\00\01\01\05\0d\0a\00\05\02\ff\ff\ff\ff\03\84\01\01\05\19\06\90\05\1c\06.\05$\06X\05\19<\03\fb~.\05\0c\06\03\86\01 \05\01\86\06\03\f6~ \05\0a\06\03\89\01 \05\01\9f\02\01\00\01\01\05\0d\0a\00\05\02\ff\ff\ff\ff\03\8c\01\01\05\19\06\90\05\1c\06.\05$\06X\05\19<\03\f3~.\05\0c\06\03\8e\01 \05\01\86\06\03\ee~ \05\0a\06\03\91\01 \05\01\9f\02\01\00\01\01=\03\00\00\04\00)\02\00\00\01\01\01\fb\0e\0d\00\01\01\01\01\00\00\00\01\00\00\01wasisdk://v34.0-rc.1/src/wasi-libc/libc-bottom-half/cloudlibc/src/libc/dirent\00wasisdk://v34.0-rc.1/build/sysroot/wasi-libc-wasm32-wasip2-build-prefix/src/wasi-libc-wasm32-wasip2-build-build/sysroot/include/wasm32-wasip2\00wasisdk://v34.0-rc.1/build/install/lib/clang/23/include\00wasis